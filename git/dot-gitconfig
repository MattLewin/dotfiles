# --- Core & UI ---
[user]
	useConfigOnly = true
[credential]
	helper =
[core]
	excludesfile = ~/.gitignore_global
	autocrlf = input
	pager = delta
	editor = nvim
	untrackedCache = true
[tag]
	sort = version:refname
[branch]
	sort = -committerdate

# --- Diff / Merge / Colors ---
[log]
	abbrevCommit = true
[interactive]
	diffFilter = delta --color-only
[delta]
	features = line-numbers decorations
	wrap-lines = true
	navigate = true
	syntax-theme = Dracula
	plus-style = syntax
	minus-style = syntax
	file-decoration-style = cyan overline
	file-style = bold yellow
	hunk-header-style = line-number syntax
	commit-decoration-style = bold yellow box ul
	commit-style = raw
[delta "line-numbers"]
	line-numbers-minus-style = bold brightred
	line-numbers-plus-style  = bold brightgreen
	line-numbers-zero-style  = syntax
[diff]
	algorithm = histogram
	colorMoved = default
	mnemonicPrefix = true
[merge]
	conflictstyle = zdiff3
	directoryRenames = true

# --- Workflow Defaults ---
[push]
	default = current
	autoSetupRemote = true
	followTags = true
	recurseSubmodules = on-demand
[remote]
	pushdefault = origin
[pull]
	rebase = merges
[fetch]
	prune = true
	pruneTags = true
	negotiationAlgorithm = skipping
	writeCommitGraph = true
[commit]
	verbose = true
[stash]
	showPatch = true
[rerere]
	enabled = true
[rebase]
	autosquash = true
	updateRefs = true
	autoStash = true
	backend = merge
[init]
	defaultBranch = develop

# --- Aliases ---
[alias]
	patch  = !git --no-pager diff --no-color --no-prefix $@
	# Untracked files hidden by ignore rules, then tracked files that match them.
	# A wholly ignored directory is one line; empty ones are skipped. (ls-files
	# --directory misreports directories that merely contain ignored files.)
	# Header color: color.ignored (falls back to color.ui) and color.ignored.header
	ignored = "!f() { \
		git status --porcelain -z --ignored=matching --untracked-files=normal \
			| tr '\\0' '\\n' | sed -n 's/^!! //p' \
			| while IFS= read -r p; do \
				case $p in */) [ -n \"$(find \"$p\" ! -type d -print -quit)\" ] || continue ;; esac; \
				printf '%s\\n' \"$p\"; \
			done; \
		t=$(git ls-files --cached --ignored --exclude-standard); \
		[ -n \"$t\" ] || return 0; \
		if [ -t 1 ]; then tty=true; else tty=false; fi; \
		if [ \"$(git config --get-colorbool color.ignored $tty)\" = true ]; then \
			c=$(git config --get-color color.ignored.header 'bold yellow'); \
			r=$(git config --get-color '' reset); \
		fi; \
		printf '\\n%sTracked, but matching ignore rules:%s\\n%s\\n' \"$c\" \"$r\" \"$t\"; \
	}; f"
	ffmain = "!git diff --quiet || { echo 'Uncommitted changes — aborting'; exit 1; }; git switch main && git fetch origin && git merge --ff-only origin/develop && git push"

# --- Filters ---
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# --- Performance & Maintenance ---
[status]
	submoduleSummary = true
[gc]
	writeCommitGraph = true
[maintenance]
	auto = true
	strategy = incremental

# --- Additional includes ---
[include]
	path = ~/.git/included.gitconfig
	path = ~/.gitconfig.mac
	path = ~/.gitconfig.local

# --- Site-specific overrides ---
