# Default: ignore everything under ~/.config
*

# Always keep this file
!.gitignore

# Allowlisted subtrees (must unignore the dir AND its contents)
# Local-override templates only. The live local.zsh / local.fish that
# bootstrap-local.sh creates from them stay ignored.
!dotfiles/
!dotfiles/*.example

!fish/
!fish/**

!ghostty/
!ghostty/**

!homebrew/
!homebrew/**
homebrew/trust.json.lock

!mise/
!mise/**

!nvim/
!nvim/**

!starship.toml

