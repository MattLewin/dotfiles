# api_tokens.zsh — sourced by zsh/dot-zsh/variables.zsh on every shell start.
#
# The real file lives at ~/.config/dotfiles/api_tokens.zsh, outside this repo,
# so it cannot be committed by accident. `make bootstrap-local` creates it from
# this template at mode 600. Fill in real values and uncomment what you need.

# Public-access-only GitHub token so Homebrew isn't rate-limited on GitHub API
# calls. Generate at https://github.com/settings/tokens with NO scopes selected —
# it grants nothing beyond anonymous access, just a higher rate limit.
# export HOMEBREW_GITHUB_API_TOKEN="ghp_REPLACE_ME"

# Legacy classic GitHub token, only if some tool still expects this variable name.
# export GITHUB_ACCESS_TOKEN="REPLACE_ME"

# AWS credentials for personal S3 use.
# export S3_ACCESS_KEY="AKIA_REPLACE_ME"
# export S3_SECRET_ACCESS_KEY="REPLACE_ME"
