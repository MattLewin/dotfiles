{
  "model": "opus",
  "effortLevel": "high",
  "permissions": {
    "allow": [
      "Bash(make lint)",
      "Bash(shellcheck *)",
      "Bash(shfmt -d *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-edited.sh"
          }
        ]
      }
    ]
  }
}
