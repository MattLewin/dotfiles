#
# NOTE: .zprofile is run *before* .zshrc on all login shells.
#

# --- Homebrew ---
if command -v brew >/dev/null 2>&1; then
  # Preferred: Let brew declare PATH, MANPATH, etc.
  eval "$(/usr/bin/env brew shellenv)"
else
  # Fallbacks if brew isn't on PATH yet
  if [ -d /opt/homebrew ]; then
    export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
    export MANPATH="/opt/homebrew/share/man:$MANPATH"
    export INFOPATH="/opt/homebrew/share/info:$INFOPATH"
  elif [ -d /usr/local/Homebrew ]; then
    export PATH="/usr/local/bin:/usr/local/sbin:$PATH"
    export MANPATH="/usr/local/share/man:$MANPATH"
    export INFOPATH="/usr/local/share/info:$INFOPATH"
  fi
fi

# --- ~/.local/bin ---
# Homebrew (and /etc/zprofile's path_helper) just pushed ahead of the .zshenv entry.
# Move it back to the front so uv's python3 beats Homebrew's in `zsh -l -c`.
if [[ -d $HOME/.local/bin ]]; then
  path=("$HOME/.local/bin" ${path:#$HOME/.local/bin})
fi
